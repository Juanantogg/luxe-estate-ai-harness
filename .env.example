# Variables de entorno requeridas por Luxe Estate.
# Copia este archivo a `.env.local` (no se commitea) y rellena los valores.

# ---------------------------------------------------------------------------
# Supabase — proyecto eacacybbdrstirdvwwsn
# ---------------------------------------------------------------------------

# URL base del proyecto Supabase (público).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Publishable / anon key (público, va al cliente).
# Recomendado: usar la publishable key moderna (`sb_publishable_...`).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Anon JWT legacy (respaldo si algún SDK lo requiere).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role key (SECRETO — solo servidor / seed scripts). NUNCA al cliente.
SUPABASE_SERVICE_ROLE_KEY=""

# Password de la DB (sólo para Supabase CLI si se usa).
SUPABASE_PASS=""

# ---------------------------------------------------------------------------
# Site URL (auth_layer)
# ---------------------------------------------------------------------------

# URL base canónica del sitio, sin trailing slash. Se usa para construir
# los `redirectTo` que se envían a Supabase Auth (OAuth Google, link de
# confirmación de signup, link de reset password).
#
# Precedencia interna (`src/lib/auth/site-url.ts`):
#   1. NEXT_PUBLIC_SITE_URL  — recomendado en prod
#   2. NEXT_PUBLIC_VERCEL_URL — preview deployments (Vercel lo inyecta solo)
#   3. http://localhost:3000  — fallback dev
#
# En desarrollo local puede omitirse. En producción es **obligatoria**
# porque `VERCEL_URL` apunta al hostname del deploy, no al dominio canónico.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
