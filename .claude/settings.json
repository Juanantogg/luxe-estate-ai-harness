{
  "permissions": {
    "allow": [
      "Bash(pnpm build *)",
      "Bash(pnpm type-check *)",
      "Bash(pnpm build *)",
      "Bash(pnpm dev *)",
      "Bash(./init.sh *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Read",
      "Write(src/**)",
      "Write(src/i18n/**)",
      "Write(progress/**)",
      "Write(feature_list.json)",
      "Edit(src/**)",
      "Edit(scripts/**)",
      "Edit(supabase/**)",
      "Edit(src/i18n/**)",
      "Edit(progress/**)",
      "Edit(feature_list.json)",
      "Bash(mkdir *)",
      "Skill(playwright-cli)",
      "Skill(playwright-cli:*)",
      "Bash(playwright-cli *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_FILE_PATH\" | grep -qE '^.*/(src|app)/.*\\.(ts|tsx|js|jsx|mjs|cjs)$'; then cd \"$CLAUDE_PROJECT_DIR\" && pnpm lint --max-warnings=0 && pnpm type-check; else exit 0; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm build"
          }
        ]
      }
    ]
  }
}
